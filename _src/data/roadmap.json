    {
      "id": "web3",
      "name": "Web3 and smart contracts",
      "color": "#b85c00",
      "bullet": "5",
      "summary": "Programs that live on a blockchain and hold money, so they have to be right before they ship.",
      "stages": [
        {
          "name": "How blockchains work",
          "note": "Hashes, blocks, consensus and accounts: what a chain is before you write code for one.",
          "topics": [
            [
              "Web3 from first principles (hands-on)",
              "https://web3.shadw.app"
            ],
            [
              "Blockchain, explained (hands-on)",
              "https://blockchain-explain.shadw.app"
            ],
            [
              "Ethereum developer docs",
              "https://ethereum.org/en/developers/docs/"
            ]
          ]
        },
        {
          "name": "Solidity",
          "note": "The main language for Ethereum smart contracts. Learn it by running it: gas, events and reverts.",
          "topics": [
            [
              "Learn Solidity (hands-on)",
              "https://learnsolidity.shadw.app"
            ],
            [
              "Solidity",
              "https://docs.soliditylang.org/"
            ],
            [
              "Solidity by Example",
              "https://solidity-by-example.org/"
            ]
          ]
        },
        {
          "name": "Tools and testing",
          "note": "Compile, test and deploy on a local chain long before a real one.",
          "topics": [
            [
              "Foundry",
              "https://book.getfoundry.sh/"
            ],
            [
              "Hardhat",
              "https://hardhat.org/docs"
            ],
            [
              "Remix",
              "https://remix-ide.readthedocs.io/"
            ]
          ]
        },
        {
          "name": "Security",
          "note": "Deployed contracts hold money and cannot be patched in place: learn the attacks first.",
          "topics": [
            [
              "OpenZeppelin Contracts",
              "https://docs.openzeppelin.com/contracts/"
            ],
            [
              "Ethernaut",
              "https://ethernaut.openzeppelin.com/"
            ],
            [
              "Smart Contract Best Practices",
              "https://github.com/ConsenSys/smart-contract-best-practices"
            ]
          ]
        },
        {
          "name": "Beyond Ethereum",
          "note": "Other chains, and other languages that compile to contracts.",
          "topics": [
            [
              "Cosmos SDK",
              "https://docs.cosmos.network/"
            ],
            [
              "SmartCOBOL (hands-on)",
              "https://smartcobol.shadw.app"
            ]
          ]
        }
      ]
    },
    {
      "id": "systems",
