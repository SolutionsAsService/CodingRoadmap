            ],
            [
              "Rust",
              "https://doc.rust-lang.org/book/"
            ],
            [
              "Learn C and its family (hands-on)",
              "https://learnc.shadw.app"
            ],
            [
              "Learn Rust (hands-on)",
              "https://learnrust.shadw.app"
            ]
          ]
        },
        {
          "name": "Operating systems",
          "note": "What sits between your program and the hardware.",
          "topics": [
            [
              "Linux kernel documentation",
              "https://docs.kernel.org/"
            ],
            [
              "HolyC and TempleOS (hands-on)",
              "https://holyc.shadw.app"
            ]
          ]
        },
        {
          "name": "Hardware and microcontrollers",
