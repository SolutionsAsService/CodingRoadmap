{
  "title": "Coding Roadmap",
  "summary": "Full-stack development as a transit map: start on the Fundamentals line, then change at any interchange onto Frontend, Backend, DevOps, Machine Learning, Web3 or Systems.",
  "tracks": [
    {
      "id": "fundamentals",
      "bullet": "0",
      "name": "Fundamentals",
      "color": "#1b1c1f",
      "trunk": true,
      "summary": "Every other line starts here. The languages, ideas and tools you use whatever you build.",
      "stages": [
        {
          "name": "First languages",
          "note": "Start with one language close to the machine and one for scripting and the web.",
          "topics": [
            [
              "C",
              "https://en.cppreference.com/c"
            ],
            [
              "Python",
              "https://docs.python.org/3/"
            ],
            [
              "JavaScript",
              "https://developer.mozilla.org/en-US/docs/Web/JavaScript"
            ]
          ]
        },
        {
          "name": "The command line",
          "note": "The shell is where you run, build and automate everything else.",
          "topics": [
            [
              "Bash reference manual",
              "https://www.gnu.org/software/bash/manual/bash.html"
            ],
            [
              "Learn Bash (hands-on)",
              "https://learnbash.shadw.app"
            ]
          ]
        },
        {
          "name": "How computers work",
          "note": "Memory, processes, files and networks: the concepts every later line assumes.",
          "topics": [
            [
              "Developer map",
              "https://developer-map.shadw.app"
            ]
          ]
        },
        {
          "name": "Algorithms and data structures",
          "note": "Arrays, lists, trees, graphs and hash maps, and how to sort, search and reason about cost.",
          "topics": []
        },
        {
          "name": "Object-oriented programming",
          "note": "Classes, objects, interfaces and composition: how most large codebases are organised.",
          "topics": []
        },
        {
          "name": "Version control",
          "note": "Track every change, work on branches and review each other's code.",
          "topics": [
            [
              "Git",
              "https://git-scm.com/doc"
            ],
            [
              "GitHub",
              "https://docs.github.com/"
            ]
          ]
        }
      ]
    },
    {
      "id": "frontend",
      "bullet": "1",
      "name": "Frontend",
      "color": "#c8102e",
      "summary": "What people see and touch in the browser and on their phones.",
      "stages": [
        {
          "name": "The web platform",
          "note": "Semantic HTML, accessibility, responsive layout with Flexbox and Grid, and JavaScript in the browser.",
          "topics": [
            [
              "HTML",
              "https://developer.mozilla.org/en-US/docs/Web/HTML"
            ],
            [
              "CSS",
              "https://developer.mozilla.org/en-US/docs/Web/CSS"
            ],
            [
              "Learn CSS (hands-on)",
              "https://learncss.shadw.app"
            ],
            [
              "Accessibility",
              "https://www.w3.org/WAI/fundamentals/"
            ],
            [
              "JavaScript",
              "https://developer.mozilla.org/en-US/docs/Web/JavaScript"
            ]
          ]
        },
        {
          "name": "Frameworks and state",
          "note": "Component frameworks, and how an app keeps its data in step with its screen.",
          "topics": [
            [
              "React",
              "https://react.dev/"
            ],
            [
              "Angular",
              "https://angular.dev/"
            ],
            [
              "Vue",
              "https://vuejs.org/"
            ],
            [
              "Svelte",
              "https://svelte.dev/"
            ]
          ]
        },
        {
          "name": "Languages and styling",
          "note": "Typed JavaScript, and ways to write and organise styles at scale.",
          "topics": [
            [
              "TypeScript",
              "https://www.typescriptlang.org/docs/"
            ],
            [
              "Sass / SCSS",
              "https://sass-lang.com/documentation/"
            ],
            [
              "Tailwind CSS",
              "https://tailwindcss.com/docs"
            ],
            [
              "CSS-in-JS (styled-components)",
              "https://styled-components.com/docs"
            ]
          ]
        },
        {
          "name": "Build and test",
          "note": "Bundle code for the browser, and check it does what you think.",
          "topics": [
            [
              "Vite",
              "https://vite.dev/guide/"
            ],
            [
              "webpack",
              "https://webpack.js.org/concepts/"
            ],
            [
              "Jest",
              "https://jestjs.io/docs/getting-started"
            ],
            [
              "Mocha",
              "https://mochajs.org/"
            ]
          ]
        },
        {
          "name": "Mobile",
          "note": "The same component ideas, shipped as native apps.",
          "topics": [
            [
              "React Native",
              "https://reactnative.dev/docs/getting-started"
            ]
          ]
        },
        {
          "name": "UX and UI design",
          "note": "Design systems, prototypes and testing with real users.",
          "topics": [
            [
              "Figma",
              "https://help.figma.com/"
            ],
            [
              "Adobe XD",
              "https://helpx.adobe.com/xd/user-guide.html"
            ],
            [
              "Design systems",
              ""
            ],
            [
              "Prototyping",
              ""
            ],
            [
              "Usability testing",
              "https://www.nngroup.com/articles/usability-testing-101/"
            ]
          ]
        }
      ]
    },
    {
      "id": "backend",
      "bullet": "2",
      "name": "Backend",
      "color": "#0039a6",
      "summary": "Servers, data and the APIs that connect them.",
      "stages": [
        {
          "name": "Dynamic languages",
          "note": "Pick one language and its main web framework, and learn it well: quick to start, interpreted.",
          "topics": [
            [
              "Node.js",
              "https://nodejs.org/en/learn"
            ],
            [
              "Django",
              "https://docs.djangoproject.com/"
            ],
            [
              "Flask",
              "https://flask.palletsprojects.com/"
            ],
            [
              "Ruby on Rails",
              "https://guides.rubyonrails.org/"
            ],
            [
              "Laravel (PHP)",
              "https://laravel.com/docs"
            ]
          ]
        },
        {
          "name": "Compiled languages",
          "note": "Typed, compiled frameworks for services that must be fast and long-lived.",
          "topics": [
            [
              "Spring (Java)",
              "https://spring.io/guides"
            ],
            [
              "Learn Java (hands-on)",
              "https://learnjava.shadw.app"
            ],
            [
              "Gin (Go)",
              "https://gin-gonic.com/en/docs/"
            ],
            [
              "Actix (Rust)",
              "https://actix.rs/docs/"
            ],
            [
              "Ktor (Kotlin)",
              "https://ktor.io/docs/"
            ]
          ]
        },
        {
          "name": "Databases",
          "note": "Relational databases for structured data, and NoSQL and in-memory stores for other shapes.",
          "topics": [
            [
              "PostgreSQL",
              "https://www.postgresql.org/docs/"
            ],
            [
              "MySQL",
              "https://dev.mysql.com/doc/"
            ],
            [
              "MongoDB",
              "https://www.mongodb.com/docs/"
            ],
            [
              "Redis",
              "https://redis.io/docs/latest/"
            ],
            [
              "Firebase",
              "https://firebase.google.com/docs"
            ]
          ]
        },
        {
          "name": "APIs and protocols",
          "note": "How clients and servers talk to each other.",
          "topics": [
            [
              "REST",
              "https://developer.mozilla.org/en-US/docs/Glossary/REST"
            ],
            [
              "GraphQL",
              "https://graphql.org/learn/"
            ],
            [
              "WebSockets",
              "https://developer.mozilla.org/en-US/docs/Web/API/WebSockets_API"
            ],
            [
              "Learn Hypercore (hands-on)",
              "https://learnhypercore.shadw.app"
            ]
          ]
        },
        {
          "name": "Security and authentication",
          "note": "Who a user is, what they may do, and how to keep it that way.",
          "topics": [
            [
              "OAuth 2.0",
              "https://oauth.net/2/"
            ],
            [
              "JWT",
              "https://datatracker.ietf.org/doc/html/rfc7519"
            ],
            [
              "Two-factor authentication",
              ""
            ],
            [
              "Single sign-on",
              ""
            ]
          ]
        },
        {
          "name": "Serverless",
          "note": "Run code on demand without managing a server.",
          "topics": [
            [
              "AWS Lambda",
              "https://docs.aws.amazon.com/lambda/"
            ],
            [
              "Google Cloud Run",
              "https://cloud.google.com/run/docs"
            ],
            [
              "Azure Functions",
              "https://learn.microsoft.com/en-us/azure/azure-functions/"
            ]
          ]
        }
      ]
    },
    {
      "id": "devops",
      "bullet": "3",
      "name": "DevOps and infrastructure",
      "color": "#00933c",
      "summary": "Getting code from a commit to production, and keeping it running.",
      "stages": [
        {
          "name": "CI/CD and deployment pipelines",
          "note": "Build, test and ship every change automatically. Jenkins pipelines are written in Groovy.",
          "topics": [
            [
              "Jenkins",
              "https://www.jenkins.io/doc/"
            ],
            [
              "GitLab CI/CD",
              "https://docs.gitlab.com/ci/"
            ],
            [
              "Learn Groovy",
              "https://learngroovy.shadw.app/"
            ]
          ]
        },
        {
          "name": "Cloud providers",
          "note": "Rent compute, storage and managed services instead of running your own.",
          "topics": [
            [
              "AWS",
              "https://docs.aws.amazon.com/"
            ],
            [
              "Google Cloud",
              "https://cloud.google.com/docs"
            ],
            [
              "Azure",
              "https://learn.microsoft.com/en-us/azure/"
            ]
          ]
        },
        {
          "name": "Infrastructure as code",
          "note": "Describe servers and networks in files you can review and rebuild from.",
          "topics": [
            [
              "Terraform",
              "https://developer.hashicorp.com/terraform/docs"
            ],
            [
              "Ansible",
              "https://docs.ansible.com/"
            ],
            [
              "CloudFormation",
              "https://docs.aws.amazon.com/cloudformation/"
            ]
          ]
        },
        {
          "name": "Containers and orchestration",
          "note": "Package an app with everything it needs, then run many copies reliably.",
          "topics": [
            [
              "Docker",
              "https://docs.docker.com/"
            ],
            [
              "Learn Docker (hands-on)",
              "https://learndocker.shadw.app"
            ],
            [
              "Kubernetes",
              "https://kubernetes.io/docs/home/"
            ],
            [
              "Learn Kubernetes (hands-on)",
              "https://learnkubernetes.shadw.app"
            ]
          ]
        },
        {
          "name": "Networking",
          "note": "Route and balance traffic in front of your services.",
          "topics": [
            [
              "Nginx",
              "https://nginx.org/en/docs/"
            ],
            [
              "HAProxy",
              "https://www.haproxy.org/"
            ],
            [
              "How the internet is run",
              "https://internet-structure.shadw.app"
            ]
          ]
        },
        {
          "name": "Monitoring and logs",
          "note": "Know when something breaks, and why.",
          "topics": [
            [
              "Prometheus",
              "https://prometheus.io/docs/"
            ],
            [
              "Grafana",
              "https://grafana.com/docs/"
            ],
            [
              "Elastic Stack (ELK)",
              "https://www.elastic.co/docs"
            ],
            [
              "Splunk",
              "https://docs.splunk.com/"
            ]
          ]
        },
        {
          "name": "Database management",
          "note": "Backups, migrations and performance for the databases you run.",
          "topics": [
            [
              "PostgreSQL",
              "https://www.postgresql.org/docs/"
            ],
            [
              "MongoDB",
              "https://www.mongodb.com/docs/"
            ]
          ]
        }
      ]
    },
    {
      "id": "ml",
      "bullet": "4",
      "name": "Machine learning and AI",
      "color": "#b933ad",
      "summary": "Models that learn from data, and the systems that feed and serve them.",
      "stages": [
        {
          "name": "Python for machine learning",
          "note": "The two main deep-learning libraries.",
          "topics": [
            [
              "TensorFlow",
              "https://www.tensorflow.org/learn"
            ],
            [
              "PyTorch",
              "https://docs.pytorch.org/docs/stable/"
            ]
          ]
        },
        {
          "name": "Data engineering",
          "note": "Move and process data at the scale models need.",
          "topics": [
            [
              "Apache Spark",
              "https://spark.apache.org/docs/latest/"
            ],
            [
              "Apache Hadoop",
              "https://hadoop.apache.org/docs/stable/"
            ]
          ]
        },
        {
          "name": "Natural language processing",
          "note": "Working with text.",
          "topics": [
            [
              "NLTK",
              "https://www.nltk.org/"
            ],
            [
              "Hugging Face",
              "https://huggingface.co/docs"
